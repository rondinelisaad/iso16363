# ── Docker compose reads this file automatically when placed at the repo root ──
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# For local development without Docker, copy to apps/api/.env instead.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Docker: DATABASE_URL is set automatically from POSTGRES_PASSWORD below.
# Local:  set the full URL here and copy file to apps/api/.env.
POSTGRES_PASSWORD=iso16363

# ── API ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
AWS_REGION=us-east-1
AWS_S3_BUCKET=iso16363-evidence
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900

# ── Web ────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production
# NOTE: this is a build-time arg for the web Docker image.
# Changing it requires rebuilding: docker compose up --build web
NEXT_PUBLIC_API_URL=http://localhost:3001
